generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Lead {
  id              String        @id @default(cuid())
  youtubeUserId   String        @unique
  youtubeUsername  String
  displayName     String
  avatarUrl       String?
  tag             String        @default("TRIAGEM")
  interesse       String        @default("INDEFINIDO")
  whatsapp        String?
  email           String?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  comments        LeadComment[]
}

model LeadComment {
  id          String   @id @default(cuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  videoId     String
  videoTitle  String?
  commentId   String   @unique
  commentText String
  commentDate DateTime
  createdAt   DateTime @default(now())
}

model Template {
  id        String   @id @default(cuid())
  name      String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SystemConfig {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model CommentStatus {
  id               String    @id @default(cuid())
  youtubeCommentId String    @unique
  videoId          String
  status           String    @default("PENDENTE")
  verifiedBy       String?
  verifiedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model CachedVideo {
  id             String   @id @default(cuid())
  youtubeVideoId String   @unique
  title          String
  thumbnail      String
  publishedAt    DateTime
  duration       String   @default("0:00")
  viewCount      Int      @default(0)
  likeCount      Int      @default(0)
  commentCount   Int      @default(0)
  isShort        Boolean  @default(false)
  lastSyncedAt   DateTime @default(now())
}
